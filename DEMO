--==============================================================
-- GITHUB SOUND
--==============================================================

local function GetGitSound(
	url,
	soundName
)

	if type(isfile) ~= "function"
		or type(writefile) ~= "function"
	then

		warn(
			"Executor does not support file functions."
		)

		return nil

	end

	local getCustom =
		getcustomasset
		or getsynasset

	if type(getCustom) ~= "function" then

		warn(
			"getcustomasset/getsynasset unavailable."
		)

		return nil

	end

	local fileName =
		soundName .. ".mp3"

	if not isfile(fileName) then

		local success,
			content =
			pcall(function()

				return game:HttpGet(url)

			end)

		if not success then

			warn(
				"Sound download failed:",
				content
			)

			return nil

		end

		if type(content) ~= "string"
			or #content == 0
		then

			warn(
				"Downloaded sound is empty."
			)

			return nil

		end

		local saved,
			saveError =
			pcall(function()

				writefile(
					fileName,
					content
				)

			end)

		if not saved then

			warn(
				"Could not save sound:",
				saveError
			)

			return nil

		end

	end

	local success,
		assetId =
		pcall(function()

			return getCustom(fileName)

		end)

	if not success
		or not assetId
	then

		warn(
			"Could not create custom sound asset."
		)

		return nil

	end

	local sound =
		Instance.new("Sound")

	sound.Name =
		soundName

	sound.SoundId =
		assetId

	sound.Volume =
		JUMPSCARE_SOUND_VOLUME

	sound.Looped =
		false

	sound.Parent =
		Workspace

	local loaded =
		pcall(function()

			if not sound.IsLoaded then

				sound.Loaded:Wait()

			end

		end)

	if not loaded then

		warn(
			"Sound failed to load."
		)

		sound:Destroy()
		return nil

	end

	local played =
		pcall(function()

			sound:Play()

		end)

	if not played then

		warn(
			"Sound failed to play."
		)

		sound:Destroy()
		return nil

	end

	print(
		"Jumpscare sound PLAYING."
	)

	return sound

end

