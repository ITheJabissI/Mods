local function setupJumpscareParticles()

	-- Freeze EVERY particle EXCEPT Face1.
	for _, object in ipairs(
		Figure:GetDescendants()
	) do

		if object:IsA("ParticleEmitter") then

			if object ~= Face1 then

				pcall(function()

					object.TimeScale = 0

				end)

				pcall(function()

					object.Squash =
						NumberSequence.new(
							JUMPSCARE_SQUASH
						)

				end)

			end

		end

	end

	-- Face1 changes AND IS FROZEN.
	if Face1 then

		Face1.Texture =
			JUMPSCARE_FACE_TEXTURE

		Face1.Enabled =
			true

		pcall(function()

			Face1.TimeScale = 0

		end)

		print(
			"FACE1 CHANGED AND FROZEN."
		)

	end

end

--==============================================================
-- SMOOTH LOOK
--==============================================================

local function smoothLookAtPlayer()

	local entityPosition =
		Figure:GetPivot().Position

	local targetPosition =
		Vector3.new(
			HRP.Position.X,
			entityPosition.Y,
			HRP.Position.Z
		)

	if (
		targetPosition -
		entityPosition
	).Magnitude <= 0.01
	then
		return
	end

	local startCFrame =
		Figure:GetPivot()

	local goalCFrame =
		CFrame.lookAt(
			entityPosition,
			targetPosition
		)

	local value =
		Instance.new(
			"NumberValue"
		)

	value.Value = 0

	local connection =
		value:GetPropertyChangedSignal(
			"Value"
		):Connect(
			function()

				if Figure
					and Figure.Parent
				then

					Figure:PivotTo(
						startCFrame:Lerp(
							goalCFrame,
							value.Value
						)
					)

				end

			end
		)

	local tween =
		TweenService:Create(
			value,

			TweenInfo.new(
				LOOK_TWEEN_TIME,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.Out
			),

			{
				Value = 1
			}
		)

	tween:Play()
	tween.Completed:Wait()

	connection:Disconnect()
	value:Destroy()

end

--==============================================================
-- JUMPSCARE
--==============================================================

local jumpscareRunning = false

local function startJumpscare()

	if jumpscareRunning then
		return
	end

	if not JUMPSCARE_ENABLED then
		return
	end

	if not playerInSight() then
		return
	end

	jumpscareRunning = true

	print("======================================")
	print("JUMPSCARE STARTED")
	print("======================================")

	-- STOP ALL EXISTING SOUNDS FIRST.
	stopAllSounds()

	--==========================================================
	-- FREEZE ENTITY
	--==========================================================

	for _, part in ipairs(
		Figure:GetDescendants()
	) do

		if part:IsA("BasePart") then
			part.Anchored = true
		end

	end

	--==========================================================
	-- SMOOTH TURN
	--==========================================================

	smoothLookAtPlayer()

	--==========================================================
	-- FACE CHANGES
	--==========================================================

	setupJumpscareParticles()

	--==========================================================
	-- CRASH SOUND STARTS IMMEDIATELY WITH FACE CHANGE
	--==========================================================

	print(
		"Starting crash/jumpscare sound..."
	)

	local crashSound =
		GetGitSound(
			JUMPSCARE_SOUND_URL,
			JUMPSCARE_SOUND_NAME
		)

	--==========================================================
	-- CAMERA
	--==========================================================

	local camera =
		Workspace.CurrentCamera

	local oldCameraType =
		camera.CameraType

	camera.CameraType =
		Enum.CameraType.Scriptable

	local cameraConnection =
		RunService.RenderStepped:Connect(
			function()

				if RushNew
					and RushNew.Parent
				then

					camera.CFrame =
						CFrame.lookAt(
							camera.CFrame.Position,
							RushNew.Position
						)

				end

			end
		)

	--==========================================================
	-- FREEZE PLAYER
	--==========================================================

	local oldWalkSpeed =
		Humanoid.WalkSpeed

	local oldJumpPower =
		Humanoid.JumpPower

	local oldAutoRotate =
		Humanoid.AutoRotate

	local oldPlatformStand =
		Humanoid.PlatformStand

	Humanoid.WalkSpeed = 0
	Humanoid.JumpPower = 0
	Humanoid.AutoRotate = false
	Humanoid.PlatformStand = true

	--==========================================================
	-- EXACTLY 3 SECOND STATIC DELAY
	--==========================================================

	print(
		"Waiting 3 seconds before static..."
	)

	task.wait(1.7)

	--==========================================================
	-- STATIC
	--==========================================================

	print(
		"STATIC STARTING"
	)

	local staticSound =
		createStaticSound()

	staticSound:Play()

	local staticTween =
		TweenService:Create(
			staticSound,

			TweenInfo.new(
				STATIC_FADE_TIME,
				Enum.EasingStyle.Linear,
				Enum.EasingDirection.In
			),

			{
				Volume =
					STATIC_SOUND_VOLUME
			}
		)

	staticTween:Play()

	--==========================================================
	-- GUI
	--==========================================================

	local PlayerGui =
		Player:WaitForChild(
			"PlayerGui"
		)

	local screenGui =
		Instance.new("ScreenGui")

	screenGui.Name =
		"JumpscareOverlay"

	screenGui.ResetOnSpawn =
		false

	screenGui.IgnoreGuiInset =
		true

	screenGui.DisplayOrder =
		999999

	screenGui.Parent =
		PlayerGui

	local imageLabel =
		Instance.new("ImageLabel")

	imageLabel.BackgroundTransparency =
		1

	imageLabel.BorderSizePixel =
		0

	imageLabel.Size =
		UDim2.new(
			1,
			0,
			1,
			0
		)

	imageLabel.Position =
		UDim2.new(
			0,
			0,
			0,
			0
		)

	imageLabel.ScaleType =
		Enum.ScaleType.Stretch

	imageLabel.Parent =
		screenGui

	--==========================================================
	-- FLASH
	--==========================================================

	local startTime =
		time()

	while
		time() - startTime
		<
		JUMPSCARE_FLASH_DURATION
	do

		imageLabel.Image =
			JUMPSCARE_IMAGE_1

		task.wait(0.05)

		if
			time() - startTime
			>=
			JUMPSCARE_FLASH_DURATION
		then
			break
		end

		imageLabel.Image =
			JUMPSCARE_IMAGE_2

		task.wait(0.05)

	end

	--==========================================================
	-- KILL
	--==========================================================

	Humanoid.Health = 0

	game.ReplicatedStorage.GameStats[
		"Player_" ..
		game.Players.LocalPlayer.Name
	].Total.DeathCause.Value = "Ripper"

