local function getNodes(room)

	local folder =
		room:FindFirstChild("Nodes")

	if not folder then
		return {}
	end

	local nodes = {}

	for _, node in ipairs(
		folder:GetChildren()
	) do

		if node:IsA("BasePart") then

			node.Anchored = true
			node.CanCollide = false

			table.insert(
				nodes,
				node
			)

		end

	end

	table.sort(
		nodes,
		function(a, b)

			return
				(tonumber(a.Name) or 0)
				<
				(tonumber(b.Name) or 0)

		end
	)

	return nodes
end

local path = {}

for i = spawnIndex, currentIndex do

	local room = rooms[i]

	if room then

		for _, node in ipairs(
			getNodes(room)
		) do

			table.insert(
				path,
				node
			)

		end

	end
end

