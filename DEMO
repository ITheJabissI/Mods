--==============================================================
-- LINE OF SIGHT
--==============================================================

local function playerInSight()

	if not Figure
		or not Figure.Parent
	then
		return false
	end

	if not HRP
		or not HRP.Parent
	then
		return false
	end

	local origin =
		RushNew.Position

	local direction =
		HRP.Position - origin

	if direction.Magnitude <= 0.01 then
		return true
	end

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		Figure
	}

	params.IgnoreWater = true

	local result =
		Workspace:Raycast(
			origin,
			direction,
			params
		)

	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(
		Character
	)
end

