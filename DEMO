local function loadEntity(asset)

	if asset:match("^rbxassetid://") then

		local success, objects =
			pcall(function()
				return game:GetObjects(asset)
			end)

		if not success
			or not objects
			or #objects == 0
		then
			warn("RBX asset loading failed:", objects)
			return nil
		end

		return objects[1]
	end

	if asset:match("^https?://") then

		local getCustom =
			getcustomasset
			or getsynasset

		if type(getCustom) ~= "function" then
			warn("getcustomasset/getsynasset unavailable.")
			return nil
		end

		if type(isfile) ~= "function"
			or type(writefile) ~= "function"
		then
			warn("Executor file functions unavailable.")
			return nil
		end

		local fileName = "RipperEntity.rbxm"

		if not isfile(fileName) then

			local success, data =
				pcall(function()
					return game:HttpGet(asset)
				end)

			if not success then
				warn("GitHub model download failed:", data)
				return nil
			end

			if type(data) ~= "string"
				or #data == 0
			then
				warn("GitHub returned an empty model.")
				return nil
			end

			local saved, errorMessage =
				pcall(function()
					writefile(fileName, data)
				end)

			if not saved then
				warn("Could not save model:", errorMessage)
				return nil
			end
		end

		local customAsset

		local success =
			pcall(function()
				customAsset = getCustom(fileName)
			end)

		if not success or not customAsset then
			warn("getcustomasset failed.")
			return nil
		end

		local objects

		local loaded, loadError =
			pcall(function()
				objects = game:GetObjects(customAsset)
			end)

		if not loaded
			or not objects
			or #objects == 0
		then
			warn("RBXM loading failed:", loadError)
			return nil
		end

		return objects[1]
	end

	return nil
end

