local function SpawnReb()

    print("================================")
    print("Starting Rebound")
    print("================================")

    --------------------------------------------------
    -- WARNING AUDIO
    --------------------------------------------------

    local warningSoundId =
        G.LoadGithubAudio(WARNING_AUDIO_URL)

    if warningSoundId then
        local arrival =
            Instance.new("Sound")

        arrival.Name = "ReboundWarning"
        arrival.SoundId = warningSoundId
        arrival.Volume = 5
        arrival.Parent = workspace
        arrival:Play()

        Debris:AddItem(arrival, 10)
    end

    --------------------------------------------------
    -- CAMERA
    --------------------------------------------------

    local camera = workspace.CurrentCamera

    local cameraShakerModule =
        ReplicatedStorage:FindFirstChild(
            "CameraShaker"
        )

    if cameraShakerModule then

        local success, cameraShaker =
            pcall(function()
                return require(cameraShakerModule)
            end)

        if success and cameraShaker then

            local camShake =
                cameraShaker.new(
                    Enum.RenderPriority.Camera.Value,
                    function(cf)
                        if camera then
                            camera.CFrame =
                                camera.CFrame * cf
                        end
                    end
                )

            camShake:Start()

            camShake:ShakeOnce(
                10,
                3,
                0.1,
                6,
                2,
                0.5
            )
        end
    end

    --------------------------------------------------
    -- WARNING EFFECT
    --------------------------------------------------

    local Warn =
        Instance.new(
            "ColorCorrectionEffect"
        )

    Warn.Name = "ReboundWarningEffect"
    Warn.TintColor =
        Color3.fromRGB(
            65,
            138,
            255
        )

    Warn.Saturation = -0.7
    Warn.Contrast = 0.2
    Warn.Parent = Lighting

    TweenService:Create(
        Warn,
        TweenInfo.new(15),
        {
            TintColor =
                Color3.fromRGB(
                    255,
                    255,
                    255
                ),

            Saturation = 0,
            Contrast = 0
        }
    ):Play()

    Debris:AddItem(Warn, 15)

    --------------------------------------------------
    -- FIRST SPAWN
    --------------------------------------------------

    local success, errorMessage =
        xpcall(
            Rebound,
            debug.traceback
        )

    if not success then
        warn("================================")
        warn("REBOUND ERROR")
        warn(errorMessage)
        warn("================================")
    end

    --------------------------------------------------
    -- ADDITIONAL REBOUNDS
    --------------------------------------------------

    local maxRebounds = 3

    local gameData =
        ReplicatedStorage:WaitForChild(
            "GameData"
        )

    local latestRoom =
        gameData:WaitForChild(
            "LatestRoom"
        )

    while maxRebounds > 0 do

        print(
            "Waiting for next room...",
            maxRebounds,
            "remaining"
        )

        local oldRoom =
            latestRoom.Value

        repeat
            latestRoom:GetPropertyChangedSignal(
                "Value"
            ):Wait()
        until latestRoom.Value ~= oldRoom

        task.wait(2)

        local success2, errorMessage2 =
            xpcall(
                Rebound,
                debug.traceback
            )

        if not success2 then
            warn("================================")
            warn("REBOUND ERROR")
            warn(errorMessage2)
            warn("================================")
        end

        maxRebounds -= 1
    end

    --------------------------------------------------
    -- ACHIEVEMENT
    --------------------------------------------------

    if workspace:FindFirstChild(
        "ReboundAchievement"
    ) then
        return
    end

    local playerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    if not playerGui then
        return
    end

    local mainUI =
        playerGui:FindFirstChild(
            "MainUI"
        )

    if not mainUI then
        return
    end

    local initiator =
        mainUI:FindFirstChild(
            "Initiator"
        )

    if not initiator then
        return
    end

    local mainGame =
        initiator:FindFirstChild(
            "Main_Game"
        )

    if not mainGame then
        return
    end

    local remoteListener =
        mainGame:FindFirstChild(
            "RemoteListener"
        )

    if not remoteListener then
        return
    end

    local modules =
        remoteListener:FindFirstChild(
            "Modules"
        )

    if not modules then
        return
    end

    local achievementModule =
        modules:FindFirstChild(
            "AchievementUnlock"
        )

    if not achievementModule then
        return
    end

    local success3, unlockFunc =
        pcall(function()
            return require(
                achievementModule
            )
        end)

    if not success3 or not unlockFunc then
        warn(
            "Could not load AchievementUnlock:",
            unlockFunc
        )

        return
    end

    if not workspace:FindFirstChild(
        "ReboundAchievement"
    ) then

        pcall(function()
            unlockFunc(
                nil,
                "Rebound"
            )
        end)

        local ObtainedBadge =
            Instance.new("BoolValue")

        ObtainedBadge.Name =
            "ReboundAchievement"

        ObtainedBadge.Value = true
        ObtainedBadge.Parent = workspace
    end

    print("Rebound sequence completed!")
end

