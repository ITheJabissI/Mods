G.LoadGithubTxtModel = function(url)
    local response = safeRequest({
        Url = url,
        Method = "GET"
    })

    if not response then
        return nil
    end

    if response.StatusCode ~= 200 then
        warn("Rebound TXT request failed:", response.StatusCode)
        return nil
    end

    local success, result = pcall(function()
        local fn = loadstring(response.Body)

        if not fn then
            error("loadstring returned nil")
        end

        return fn()
    end)

    if success then
        return result
    end

    warn("Rebound TXT model error:", result)

    return nil
end

--------------------------------------------------
-- GET ENTITY ROOT
--------------------------------------------------

local function GetEntityRoot(entity)
    if not entity then
        return nil
    end

    if entity:IsA("BasePart") then
        return entity
    end

    if entity:IsA("Model") then
        if entity.PrimaryPart then
            return entity.PrimaryPart
        end

        local root =
            entity:FindFirstChild("HumanoidRootPart", true)
            or entity:FindFirstChild("RootPart", true)
            or entity:FindFirstChildWhichIsA("BasePart", true)

        if root then
            pcall(function()
                entity.PrimaryPart = root
            end)

            return root
        end
    end

    return entity:FindFirstChildWhichIsA("BasePart", true)
end

--------------------------------------------------
-- MOVE ENTITY
--------------------------------------------------

local function SetEntityCFrame(entity, cf)
    if not entity then
        return
    end

    if entity:IsA("Model") then
        pcall(function()
            entity:PivotTo(cf)
        end)
    elseif entity:IsA("BasePart") then
        entity.CFrame = cf
    end
end

local function TweenEntity(entity, targetCFrame, duration)
    if not entity then
        return
    end

    if entity:IsA("BasePart") then
        local tween = TweenService:Create(
            entity,
            TweenInfo.new(
                duration,
                Enum.EasingStyle.Sine,
                Enum.EasingDirection.Out
            ),
            {
                CFrame = targetCFrame
            }
        )

        tween:Play()
        tween.Completed:Wait()

        return
    end

    if entity:IsA("Model") then
        local cfValue = Instance.new("CFrameValue")
        cfValue.Value = entity:GetPivot()

        local connection = cfValue:GetPropertyChangedSignal("Value"):Connect(
            function()
                if entity and entity.Parent then
                    entity:PivotTo(cfValue.Value)
                end
            end
        )

        local tween = TweenService:Create(
            cfValue,
            TweenInfo.new(
                duration,
                Enum.EasingStyle.Sine,
                Enum.EasingDirection.Out
            ),
            {
                Value = targetCFrame
            }
        )

        tween:Play()
        tween.Completed:Wait()

        connection:Disconnect()
        cfValue:Destroy()
    end
end

