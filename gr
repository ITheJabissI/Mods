local function Rebound()
    local gameData = ReplicatedStorage:WaitForChild("GameData")
    local latestRoom = gameData:WaitForChild("LatestRoom")
    local currentRooms = workspace:WaitForChild("CurrentRooms")

    local killed = false
    local speed = 2

    print("================================")
    print("Rebound spawning...")
    print("Current room:", latestRoom.Value)
    print("================================")

    --------------------------------------------------
    -- CAMERA
    --------------------------------------------------

    local camera = workspace.CurrentCamera
    local cameraShaker

    local cameraShakerModule = ReplicatedStorage:FindFirstChild("CameraShaker")

    if cameraShakerModule then
        local success, result = pcall(function()
            return require(cameraShakerModule)
        end)

        if success then
            cameraShaker = result
        else
            warn("Rebound: CameraShaker failed:", result)
        end
    end

    local camShake

    if cameraShaker then
        camShake = cameraShaker.new(
            Enum.RenderPriority.Camera.Value,
            function(cf)
                if camera then
                    camera.CFrame = camera.CFrame * cf
                end
            end
        )

        camShake:Start()
    end

    --------------------------------------------------
    -- LOAD MODEL
    --------------------------------------------------

    local entity = G.LoadGithubModel(MODEL_URL)

    if not entity then
        warn("================================")
        warn("FAILED TO LOAD REBOUND MODEL")
        warn("================================")
        return
    end

    entity.Name = "Rebound"

    entity.Parent = workspace

    print("Rebound model parented to workspace")

    --------------------------------------------------
    -- GET ROOT
    --------------------------------------------------

    local entityPart = GetEntityRoot(entity)

    if not entityPart then
        warn("Rebound model has no BasePart/root!")

        entity:Destroy()

        return
    end

    entityPart.Anchored = true
    entityPart.CanCollide = false

    --------------------------------------------------
    -- FIND NEXT ROOM
    --------------------------------------------------

    local targetRoomNumber = latestRoom.Value + 1

    print("Waiting for room:", targetRoomNumber)

    local targetRoom = currentRooms:FindFirstChild(
        tostring(targetRoomNumber)
    )

    if not targetRoom then
        targetRoom = currentRooms:WaitForChild(
            tostring(targetRoomNumber),
            10
        )
    end

    if not targetRoom then
        warn(
            "Rebound: room " ..
            tostring(targetRoomNumber) ..
            " never spawned."
        )

        entity:Destroy()

        return
    end

    local roomExit = targetRoom:FindFirstChild("RoomExit")

    if not roomExit then
        warn("Rebound: target room has no RoomExit")

        entity:Destroy()

        return
    end

    --------------------------------------------------
    -- SPAWN ENTITY
    --------------------------------------------------

    SetEntityCFrame(
        entity,
        roomExit.CFrame + Vector3.new(0, 0.6, 0)
    )

    print(
        "Rebound spawned at room",
        targetRoomNumber
    )

    --------------------------------------------------
    -- WAIT BEFORE MOVING
    --------------------------------------------------

    task.wait(4)

    --------------------------------------------------
    -- MOVING SOUND
    --------------------------------------------------

    local movingSoundId =
        G.LoadGithubAudio(MOVING_AUDIO_URL)

    local moving

    if movingSoundId then
        moving = Instance.new("Sound")
        moving.Name = "ReboundMoving"
        moving.SoundId = movingSoundId
        moving.Volume = 10
        moving.Parent = entityPart
        moving:Play()
    end

    --------------------------------------------------
    -- TARGET CHECK
    --------------------------------------------------

    local function isBossActive()
        local roomNumber = latestRoom.Value

        if roomNumber == 50 or roomNumber == 100 then
            return true
        end

        for _, sound in ipairs(
            ReplicatedStorage:GetDescendants()
        ) do
            if sound:IsA("Sound")
                and sound.IsPlaying
                and (
                    sound.Name:find("Music")
                    or sound.Name == "Shade"
                )
            then
                return true
            end
        end

        return false
    end

    local function canSeeTarget(target, distance)
        if killed then
            return false
        end

        if not target then
            return false
        end

        if isBossActive() then
            return false
        end

        local targetRoot =
            target:FindFirstChild("HumanoidRootPart")

        if not targetRoot then
            return false
        end

        local origin = entityPart.Position

        local direction =
            (targetRoot.Position - origin).Unit * distance

        local raycastParams = RaycastParams.new()

        raycastParams.FilterType =
            Enum.RaycastFilterType.Exclude

        raycastParams.FilterDescendantsInstances = {
            entity,
            target
        }

        local result = workspace:Raycast(
            origin,
            direction,
            raycastParams
        )

        if not result then
            killed = true
            return true
        end

        if result.Instance:IsDescendantOf(target) then
            killed = true
            return true
        end

        return false
    end

    --------------------------------------------------
    -- PLAYER DETECTION
    --------------------------------------------------

    task.spawn(function()
        while entity
            and entity.Parent
            and entityPart
            and entityPart.Parent
        do
            task.wait(0.5)

            if killed then
                break
            end

            local character =
                LocalPlayer.Character

            local humanoidRoot =
                character
                and character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if humanoidRoot then

                local distance =
                    (
                        entityPart.Position
                        - humanoidRoot.Position
                    ).Magnitude

                --------------------------------------------------
                -- JUMPSCARE
                --------------------------------------------------

                if distance <= 50
                    and canSeeTarget(character, 50)
                    and not character:GetAttribute("Hiding")
                then

                    if moving then
                        moving:Stop()
                    end

                    local PlayerGui =
                        LocalPlayer:WaitForChild(
                            "PlayerGui"
                        )

                    --------------------------------------------------
                    -- GUI
                    --------------------------------------------------

                    local ReboundJs =
                        Instance.new("ScreenGui")

                    ReboundJs.Name = "ReboundJs"
                    ReboundJs.ResetOnSpawn = false
                    ReboundJs.IgnoreGuiInset = true
                    ReboundJs.Parent = PlayerGui

                    local Static =
                        Instance.new("ImageLabel")

                    Static.Name = "Static"
                    Static.BackgroundTransparency = 1
                    Static.Size = UDim2.new(11, 0, 111, 0)
                    Static.Image =
                        "rbxassetid://236543215"
                    Static.ImageTransparency = 1
                    Static.Parent = ReboundJs

                    local ReboundImage =
                        Instance.new("ImageLabel")

                    ReboundImage.Name = "Rebound"
                    ReboundImage.BackgroundTransparency = 1
                    ReboundImage.Position =
                        UDim2.new(
                            0.4866,
                            0,
                            0.4793,
                            0
                        )
                    ReboundImage.Size =
                        UDim2.new(
                            0.0267,
                            0,
                            0.0387,
                            0
                        )
                    ReboundImage.Image =
                        "rbxassetid://10914800940"
                    ReboundImage.Parent = ReboundJs

                    local JSSIZE =
                        Instance.new("ImageLabel")

                    JSSIZE.Name = "JSSIZE"
                    JSSIZE.BackgroundTransparency = 1
                    JSSIZE.Position =
                        UDim2.new(
                            -0.586,
                            0,
                            -1.251,
                            0
                        )
                    JSSIZE.Size =
                        UDim2.new(
                            2.128,
                            0,
                            3.081,
                            0
                        )
                    JSSIZE.Visible = false
                    JSSIZE.Image =
                        "rbxassetid://10914800940"
                    JSSIZE.Parent = ReboundJs

                    --------------------------------------------------
                    -- STATIC EFFECT
                    --------------------------------------------------

                    task.spawn(function()
                        while ReboundJs
                            and ReboundJs.Parent
                        do
                            Static.Image =
                                "rbxassetid://236543215"

                            task.wait(0.002)

                            Static.Rotation = 0

                            task.wait(0.002)

                            Static.Rotation = 180

                            task.wait(0.002)

                            Static.Image =
                                "rbxassetid://236777652"

                            task.wait(0.002)

                            Static.Rotation = 0

                            task.wait(0.002)

                            Static.Rotation = 180

                            task.wait(0.002)
                        end
                    end)

                    --------------------------------------------------
                    -- JUMPSCARE
                    --------------------------------------------------

                    task.spawn(function()
                        local jumpscareSoundId =
                            G.LoadGithubAudio(
                                JUMPSCARE_AUDIO_URL
                            )

                        if jumpscareSoundId then
                            local jumpscare =
                                Instance.new("Sound")

                            jumpscare.Name =
                                "ReboundJumpscare"

                            jumpscare.SoundId =
                                jumpscareSoundId

                            jumpscare.Volume = 5
                            jumpscare.Parent = workspace
                            jumpscare:Play()

                            Debris:AddItem(
                                jumpscare,
                                10
                            )
                        end

                        TweenService:Create(
                            Static,
                            TweenInfo.new(0.5),
                            {
                                ImageTransparency = 0.8
                            }
                        ):Play()

                        TweenService:Create(
                            ReboundImage,
                            TweenInfo.new(0.5),
                            {
                                Size = JSSIZE.Size,
                                Position = JSSIZE.Position
                            }
                        ):Play()

                        --------------------------------------------------
                        -- DAMAGE
                        --------------------------------------------------

                        task.spawn(function()
                            task.wait(0.3)

                            local char =
                                LocalPlayer.Character

                            if not char then
                                return
                            end

                            local humanoid =
                                char:FindFirstChildWhichIsA(
                                    "Humanoid"
                                )

                            if humanoid then
                                humanoid:TakeDamage(100)
                            end

                            --------------------------------------------------
                            -- DEATH CAUSE
                            --------------------------------------------------

                            local GameStats =
                                ReplicatedStorage:FindFirstChild(
                                    "GameStats"
                                )

                            if GameStats then
                                local playerStats =
                                    GameStats:FindFirstChild(
                                        "Player_" ..
                                        LocalPlayer.Name
                                    )

                                if playerStats then
                                    local total =
                                        playerStats:FindFirstChild(
                                            "Total"
                                        )

                                    if total then
                                        local deathCause =
                                            total:FindFirstChild(
                                                "DeathCause"
                                            )

                                        if deathCause then
                                            deathCause.Value =
                                                "Rebound"
                                        end
                                    end
                                end
                            end

                            --------------------------------------------------
                            -- DEATH HINT
                            --------------------------------------------------

                            local hints = {
                                "You died to the entity designated as Rebound...",
                                "He could trick you by coming through the next doors in the next few seconds!",
                                "Whenever this happens, do not go forward, stay on your desired hiding spot!"
                            }

                            local remotes =
                                ReplicatedStorage:FindFirstChild(
                                    "RemotesFolder"
                                )

                            if remotes then
                                remotesFolder = remotes

                                local deathHint =
                                    remotes:FindFirstChild(
                                        "DeathHint"
                                    )

                                if deathHint
                                    and firesignal
                                then
                                    pcall(function()
                                        firesignal(
                                            deathHint.OnClientEvent,
                                            hints,
                                            "Blue"
                                        )
                                    end)
                                end

                            else
                                local bricks =
                                    ReplicatedStorage:FindFirstChild(
                                        "Bricks"
                                    )

                                if bricks then
                                    remotesFolder = bricks

                                    local deathHint =
                                        bricks:FindFirstChild(
                                            "DeathHint"
                                        )

                                    if deathHint
                                        and firesignal
                                    then
                                        pcall(function()
                                            firesignal(
                                                deathHint.OnClientEvent,
                                                hints
                                            )
                                        end)
                                    end
                                end
                            end
                        end)

                        task.wait(0.5)

                        TweenService:Create(
                            Static,
                            TweenInfo.new(1),
                            {
                                ImageTransparency = 1
                            }
                        ):Play()

                        TweenService:Create(
                            ReboundImage,
                            TweenInfo.new(0.3),
                            {
                                ImageTransparency = 1
                            }
                        ):Play()

                        task.wait(1)

                        if ReboundJs then
                            ReboundJs:Destroy()
                        end
                    end)
                end

                --------------------------------------------------
                -- CAMERA SHAKE
                --------------------------------------------------

                if distance <= 60 and camShake then
                    camShake:Start()

                    camShake:ShakeOnce(
                        17,
                        9,
                        0,
                        2,
                        1,
                        6
                    )
                end
            end
        end
    end)

    --------------------------------------------------
    -- MOVE BACK THROUGH ROOMS
    --------------------------------------------------

    for i = latestRoom.Value, 1, -1 do

        if not entity
            or not entity.Parent
        then
            break
        end

        local room =
            currentRooms:FindFirstChild(
                tostring(i)
            )

        if room then

            local entrance =
                room:FindFirstChild(
                    "RoomEntrance"
                )

            if entrance then

                TweenEntity(
                    entity,
                    entrance.CFrame
                        + Vector3.new(0, 0.6, 0),
                    speed
                )
            end
        end
    end

    --------------------------------------------------
    -- CLEANUP
    --------------------------------------------------

    if entityPart then
        entityPart.Anchored = false
        entityPart.CanCollide = false
    end

    Debris:AddItem(entity, 5)

    print("Rebound finished")
end

