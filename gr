--------------------------------------------------

local function generateHash(url)
    local hash = 0

    for i = 1, #url do
        hash = (hash * 31 + string.byte(url, i)) % 4294967296
    end

    return tostring(hash)
end

local function safeRequest(options)
    if not request then
        warn("Rebound: executor does not provide request()")
        return nil
    end

    local success, response = pcall(function()
        return request(options)
    end)

    if not success then
        warn("Rebound request failed:", response)
        return nil
    end

    return response
end

--------------------------------------------------
-- LOAD AUDIO
--------------------------------------------------

G.LoadGithubAudio = function(url)
    if not writefile or not getcustomasset or not request then
        warn("Rebound: missing writefile/getcustomasset/request")
        return nil
    end

    local fileName = "rebound_audio_" .. generateHash(url) .. ".mp3"

    -- Cache
    if isfile then
        local exists = false

        pcall(function()
            exists = isfile(fileName)
        end)

        if exists then
            local success, assetId = pcall(function()
                return getcustomasset(fileName)
            end)

            if success and assetId then
                print("Rebound audio loaded from cache:", fileName)
                return assetId
            end
        end
    end

    -- Download
    local response = safeRequest({
        Url = url,
        Method = "GET",
        Headers = {
            ["Accept"] = "audio/mpeg, audio/ogg, application/octet-stream"
        }
    })

    if not response then
        return nil
    end

    if response.StatusCode ~= 200 then
        warn(
            "Rebound: audio download failed. Status:",
            tostring(response.StatusCode)
        )
        return nil
    end

    if not response.Body or #response.Body == 0 then
        warn("Rebound: downloaded audio is empty")
        return nil
    end

    local writeSuccess, writeError = pcall(function()
        writefile(fileName, response.Body)
    end)

    if not writeSuccess then
        warn("Rebound: writefile failed:", writeError)
        return nil
    end

    local assetSuccess, assetId = pcall(function()
        return getcustomasset(fileName)
    end)

    if not assetSuccess or not assetId then
        warn("Rebound: getcustomasset failed:", assetId)
        return nil
    end

    print("Rebound audio downloaded:", fileName)

    return assetId
end

--------------------------------------------------
-- LOAD RBXM MODEL
--------------------------------------------------

G.LoadGithubModel = function(url)
    if not request or not writefile or not getcustomasset then
        warn("Rebound: missing request/writefile/getcustomasset")
        return nil
    end

    local fileName = "rebound_model_" .. generateHash(url) .. ".rbxm"

    local function loadCachedModel()
        if not isfile then
            return nil
        end

        local exists = false

        pcall(function()
            exists = isfile(fileName)
        end)

        if not exists then
            return nil
        end

        local assetSuccess, assetId = pcall(function()
            return getcustomasset(fileName)
        end)

        if not assetSuccess or not assetId then
            warn("Rebound: couldn't get cached asset:", assetId)
            return nil
        end

        local objectSuccess, objects = pcall(function()
            return game:GetObjects(assetId)
        end)

        if not objectSuccess then
            warn("Rebound: GetObjects failed:", objects)
            return nil
        end

        if objects and objects[1] then
            return objects[1]
        end

        return nil
    end

    -- Try cache first
    local cached = loadCachedModel()

    if cached then
        print("Rebound model loaded from cache")
        return cached
    end

    -- Download
    print("Downloading Rebound model...")

    local response = safeRequest({
        Url = url,
        Method = "GET"
    })

    if not response then
        return nil
    end

    if response.StatusCode ~= 200 then
        warn(
            "Rebound: model download failed. Status:",
            tostring(response.StatusCode)
        )
        return nil
    end

    if not response.Body or #response.Body == 0 then
        warn("Rebound: model download returned empty data")
        return nil
    end

    local writeSuccess, writeError = pcall(function()
        writefile(fileName, response.Body)
    end)

    if not writeSuccess then
        warn("Rebound: failed to save model:", writeError)
        return nil
    end

    local assetSuccess, assetId = pcall(function()
        return getcustomasset(fileName)
    end)

    if not assetSuccess or not assetId then
        warn("Rebound: getcustomasset failed:", assetId)
        return nil
    end

    local objectSuccess, objects = pcall(function()
        return game:GetObjects(assetId)
    end)

    if not objectSuccess then
        warn("Rebound: GetObjects failed:", objects)
        return nil
    end

    if not objects or not objects[1] then
        warn("Rebound: model contained no objects")
        return nil
    end

    print("Rebound model loaded successfully")

    return objects[1]
end

