---====== Debug entity ======---

entity:SetCallback("OnSpawned", function()
    print("Entity has spawned")
    local meow = Instance.new("Sound", workspace)
    meow.SoundId = "rbxassetid://106544266586869"
    meow.PlayBackSpeed = 1
    meow.Volume = 5
    meow.Looped = false
    meow:Play()
end)

entity:SetCallback("OnStartMoving", function()
    print("Entity has started moving")
end)

entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
    if firstTime == true then
        print("Entity has entered room: ".. room.Name.. " for the first time")
    else
        print("Entity has entered room: ".. room.Name.. " again")
    end
end)

entity:SetCallback("OnLookAt", function(lineOfSight: boolean)
	if lineOfSight == true then
		print("Player is looking at entity")
	else
		print("Player view is obstructed by something")
	end
end)

entity:SetCallback("OnRebounding", function(startOfRebound: boolean)
    if startOfRebound == true then
        print("Entity has started rebounding")
	else
        print("Entity has finished rebounding")
	end
end)

entity:SetCallback("OnDespawning", function()
    print("Entity is despawning")
end)

entity:SetCallback("OnDespawned", function()
    print("Entity has despawned")
end)

entity:SetCallback("OnDamagePlayer", function(newHealth: number)
	if newHealth <= 0 then
		print("Entity has killed the player")
        -- JUMPSCARE CORE SETUP
    local players = game:GetService("Players")
    local localPlayer = players.LocalPlayer
    local playerGui = localPlayer:WaitForChild("PlayerGui")
    
    -- Create ScreenGui Container
    local sc = Instance.new("ScreenGui")
    sc.Name = "CatGui"
    sc.IgnoreGuiInset = true
    sc.DisplayOrder = 999999
    sc.Parent = playerGui
    
    -- Fullscreen Background for Flashing Lights
    local flashBg = Instance.new("Frame")
    flashBg.Size = UDim2.new(1, 0, 1, 0)
    flashBg.BackgroundColor3 = Color3.new(1, 1, 0)
    flashBg.BorderSizePixel = 0
    flashBg.Parent = sc

    
    -- Play Jumpscare Sound
    local jumpSound = Instance.new("Sound")
    jumpSound.SoundId = "rbxassetid://106544266586869"
    jumpSound.Volume = 5
    jumpSound.Parent = workspace
    jumpSound:Play()
    
    -- Chaotic Loop Control (Exactly 1 second)
    local startTime = os.clock()
    local flashColors = {Color3.new(1, 1, 0), Color3.new(0, 0, 0)} -- White, Red, Black
    
    task.spawn(function()
        while os.clock() - startTime < 1 do
            -- 1. Rapidly flash background colors
            flashBg.BackgroundColor3 = flashColors[math.random(1, #flashColors)]
            
            -- 2. Create ONE face at a time
            local img = Instance.new("ImageLabel")
            img.Image = "rbxassetid://8481648912"
            img.BackgroundTransparency = 1
            img.BorderSizePixel = 0
            img.AnchorPoint = Vector2.new(0.5, 0.5) -- Anchor center for clean scaling/rotation
            
            -- Dynamic Random Sizing (Can get extremely massive or tiny/stretched)
            local randomWidth = math.random(100, 2500)
            local randomHeight = math.random(100, 2500)
            img.Size = UDim2.new(0, randomWidth, 0, randomHeight)
            
            -- Random Position across screen space
            img.Position = UDim2.new(math.random(0, 100)/100, 0, math.random(0, 100)/100, 0)
            
            -- Completely Random Rotation (0 to 360 degrees)
            img.Rotation = math.random(0, 360)
            
            img.Parent = sc
            
            -- Brief delay so it stays on screen solo before disappearing and cycling to the next face
            task.wait(0.04) 
            img:Destroy()
        end
        
        -- Clean up remaining GUI assets
        sc:Destroy()
        jumpSound:Destroy()
    end)

	else
		print("Entity has damaged the player")
	end
end)

